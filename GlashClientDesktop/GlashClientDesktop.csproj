<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ApplicationIcon>Assets\logo.ico</ApplicationIcon>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<PublishAot>true</PublishAot>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
	</ItemGroup>
	
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />		
		<PackageReference Include="Irihi.Ursa.Themes.Semi" Version="2.2.0" />
		<PackageReference Include="Quick.Localize" Version="2.0.6" />
		<PackageReference Include="Quick.LiteDB.Plus" Version="1.0.4" />
		<PackageReference Include="Quick.Protocol.Tcp" Version="2.9.5" />
		<PackageReference Include="Quick.Protocol.Http.Client" Version="2.9.5" />
	  	<PackageReference Include="Quick.Protocol.WebSocket.Client" Version="2.9.5" />
	  	<PackageReference Include="ReactiveUI.Avalonia" Version="12.1.6" />
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
		<PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Include="locale/zh.mo" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Glash\Glash.csproj" />
	</ItemGroup>
</Project>
